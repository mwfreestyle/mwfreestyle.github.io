---
title: Area Closed
layout: base.njk
permalink: /404.html
mainClass: main--full-bleed
---

<section class="error-404" id="error-404">
  <div class="error-404__bg">
  </div>

  <div class="error-404__layers">
    <img src="/img/404/boundary.webp"
         alt="Closed area boundary sign with rope line"
         class="error-404__layer error-404__boundary"
         data-depth="0.15">
    <img src="/img/404/patrol.webp"
         alt="Ski patroller looking directly at the camera"
         class="error-404__layer error-404__patrol"
         data-depth="0.5"
         data-depth-mobile="0.35">
  </div>

  <div class="error-404__content">
    <div class="error-404__sign error-404__layer"
         data-depth="0.1">
      <div class="error-404__sign-red">
        RESORT AREA<br>CLOSED
      </div>
      <div class="error-404__sign-yellow">
        <h1 class="error-404__code">404</h1>
        <p class="error-404__message">
          You have crossed the rope line.
        </p>
        <p class="error-404__message">
          This page does not exist within patrolled
          boundaries.
        </p>
      </div>
    </div>

    <a href="/" class="btn btn-cta">
      Return to marked trails
    </a>
  </div>
</section>

<script src="/js/parallax-404.js" defer></script>
