<nav class="site-nav">
<a class="site-nav__brand" href="/">
  <img src="/img/logo.webp"
       alt="{{ site.shortTitle }}"
       class="site-nav__logo">
</a>

<button class="site-nav__toggle" aria-expanded="false"
        aria-controls="site-nav-menu">
  <span class="site-nav__toggle-bar"></span>
  <span class="site-nav__toggle-bar"></span>
  <span class="site-nav__toggle-bar"></span>
  <span class="visually-hidden">Menu</span>
</button>

  <ul id="site-nav-menu" class="site-nav__menu">
    {% for item in nav.items %}
      <li class="site-nav__item
                 {% if item.children %}has-children{% endif %}">

        {% if item.url %}
          <a href="{{ item.url }}">{{ item.label }}</a>
        {% else %}
          <span>{{ item.label }}</span>
        {% endif %}

        {% if item.children %}
          <ul class="site-nav__submenu">
            {% for child in item.children %}
              <li class="site-nav__subitem
                         {% if child.children %}has-children{% endif %}">

                {% if child.url %}
                  <a href="{{ child.url }}">{{ child.label }}</a>
                {% else %}
                  <span>{{ child.label }}</span>
                {% endif %}

                {% if child.children %}
                  <ul class="site-nav__subsubmenu">
                    {% for grandchild in child.children %}
                      <li>
                        <a href="{{ grandchild.url }}">
                          {{ grandchild.label }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}

              </li>
            {% endfor %}
          </ul>
        {% endif %}

      </li>
    {% endfor %}
    <li class="site-nav__social">
      {% socialLink "facebook", "https://www.facebook.com/mwfreestyle/",
        "MWFC Facebook Group" %}
      {% socialLink "instagram",
        "https://www.instagram.com/mountwashingtonfreestyle/",
        "@mountwashingtonfreestyle" %}
    </li>
  </ul>
</nav>
